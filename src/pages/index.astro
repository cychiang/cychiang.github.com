---
import { getCollection } from 'astro:content';
import DeckWall from '../components/DeckWall.astro';
import PostList from '../components/PostList.astro';
import Prompt from '../components/Prompt.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// Drafts show up while developing and are left out of the published site.
const decks = (await getCollection('decks', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: Astro.site?.href,
  description: site.description,
  author: { '@type': 'Person', name: site.author.name, url: site.author.url, sameAs: site.links.map((l) => l.href) },
};
---

<Base jsonLd={jsonLd}>
  <div class="home">
    <section class="intro">
      <Prompt command="cat about.txt" />
      <h1>{site.headline}</h1>
    </section>

    <div class="columns">
      <section class="posts">
        <Prompt command="ls posts/" />
        <h2 class="visually-hidden">Posts</h2>
        <PostList posts={posts} />
      </section>

      <section class="decks">
        <Prompt command="ls decks/" />
        <h2 class="visually-hidden">Decks</h2>
        <DeckWall decks={decks} />
      </section>
    </div>
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(2rem, 5vw, 3.5rem);
  }

  h1 {
    max-width: 24ch;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4.4vw, 3rem);
    font-weight: var(--weight-strong);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .posts :global(.prompt),
  .decks :global(.prompt) {
    margin-bottom: 1.25rem;
  }

  .decks {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .posts,
  .decks {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Posts on the left, decks on the right, once both have room. */
  @media (min-width: 60rem) {
    .columns {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: calc(var(--wall-gap) * 2);
      align-items: start;
    }

    .decks {
      margin-top: 0;
    }
  }

  /* The whole page fits one screen: the lists take the height that is left
     and src/scripts/pager.ts pages them. Only while paging runs, so without
     JavaScript the page scrolls and shows everything. Mirrors FIT_QUERY. */
  @media (min-width: 60rem) and (min-height: 34rem) {
    :global(html.paged body) {
      height: 100dvh;
    }

    :global(html.paged main) {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    :global(html.paged .site-footer) {
      margin-top: 0;
    }

    :global(html.paged) .home {
      display: flex;
      flex: 1;
      flex-direction: column;
      min-height: 0;
      padding-bottom: 1.5rem;
    }

    :global(html.paged) .intro {
      padding-block: clamp(1.25rem, 4vh, 2.5rem);
    }

    :global(html.paged) h1 {
      max-width: none;
      font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    }

    :global(html.paged) .columns {
      flex: 1;
      min-height: 0;
      align-items: stretch;
    }

    :global(html.paged) .posts,
    :global(html.paged) .decks {
      min-height: 0;
    }
  }
</style>
