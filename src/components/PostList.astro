---
// Posts as a listing: one row per post, like `ls -l`, date and title only.
// Newest first, paged by src/scripts/pager.ts.
import type { CollectionEntry } from 'astro:content';
import Pager from './Pager.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

{
  posts.length === 0 ? (
    <p class="empty">No posts yet.<span class="cursor" aria-hidden="true" /></p>
  ) : (
    <ol class="posts" data-post-list>
      {posts.map((post) => {
        const iso = post.data.date.toISOString().slice(0, 10);
        return (
          <li class="post">
            <time datetime={iso}>{iso}</time>
            <a href={`${base}/posts/${post.id}/`}>{post.data.title}</a>
            {post.data.draft && <span class="post-draft">draft</span>}
          </li>
        );
      })}
    </ol>
  )
}

{posts.length > 0 && <Pager name="posts" label="Posts pages" />}

<script>
  import { createPager } from '../scripts/pager';

  const list = document.querySelector<HTMLElement>('[data-post-list]');
  if (list) {
    const posts = [...list.children] as HTMLElement[];
    createPager({ list, name: 'posts', items: () => posts, perPage: 5 });
  }
</script>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One line per post, so every row is the same height and a page is an
     exact number of rows. A long title ends in an ellipsis. */
  .post {
    display: flex;
    gap: 2ch;
    align-items: baseline;
    min-width: 0;
    white-space: nowrap;
    padding: 0.75rem 0;
    border-bottom: var(--border) solid var(--color-line);
  }

  .post:not([hidden]) {
    border-top: var(--border) solid var(--color-line);
  }

  .post:not([hidden]) ~ .post {
    border-top: 0;
  }

  .post[hidden] {
    display: none;
  }

  /* On one screen the list takes the height it is given; the pager decides
     how many rows that is. */
  @media (min-width: 60rem) and (min-height: 34rem) {
    :global(html.paged) .posts {
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }
  }

  time {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .post a {
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: var(--weight-strong);
  }

  .post-draft {
    color: var(--color-flag);
    font-size: var(--text-sm);
  }

  .empty {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.5ch;
    vertical-align: text-bottom;
    background: var(--color-prompt);
  }
</style>
