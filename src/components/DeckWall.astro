---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { typeLabels } from '../site.config';
import DeckCard from './DeckCard.astro';
import Pager from './Pager.astro';

interface Props {
  decks: CollectionEntry<'decks'>[];
}

const { decks } = Astro.props;

// Optional cover image per deck: decks/<slug>/cover.png (or .jpg / .webp).
const coverFiles = import.meta.glob<ImageMetadata>('/decks/*/cover.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
const covers = new Map(
  Object.entries(coverFiles).map(([file, image]) => [file.split('/').at(-2), image]),
);

// Filters only earn their place once there is more than one kind of deck.
const types = [...new Set(decks.map((deck) => deck.data.type))];
const showFilters = types.length > 1;

// Until the wall has a full first row, mark where the next decks will go.
const emptySlots = Math.max(0, 3 - decks.length);
---

{
  showFilters && (
    <div class="filters" role="group" aria-label="Show decks by kind">
      <span aria-hidden="true">--type</span>
      <button type="button" data-filter="all" aria-pressed="true">all</button>
      {types.map((type) => (
        <button type="button" data-filter={type} aria-pressed="false">
          {(typeLabels[type]?.many ?? type).toLowerCase()}
        </button>
      ))}
    </div>
  )
}

<div class="wall" data-wall>
  {decks.map((deck) => <DeckCard deck={deck} cover={covers.get(deck.id)} />)}
  {
    Array.from({ length: emptySlots }, (_, index) => (
      <div class="empty-slot" data-empty-slot>
        <span class="slot-bar" aria-hidden="true" />
        <span class="slot-body">
          {index === 0 && (
            <p>
              {decks.length === 0 ? 'The first deck goes here.' : 'The next deck goes here.'}
              <span class="cursor" aria-hidden="true" />
            </p>
          )}
        </span>
        <span class="slot-bar" aria-hidden="true" />
      </div>
    ))
  }
</div>

<Pager name="decks" label="Deck pages" />

<script>
  import { createPager } from '../scripts/pager';

  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  let type = 'all';

  /** The decks of the chosen type, then the empty slots when showing all. */
  function items(): HTMLElement[] {
    const children = [...(wall?.children ?? [])] as HTMLElement[];
    return children.filter((child) =>
      'emptySlot' in child.dataset ? type === 'all' : type === 'all' || child.dataset.type === type,
    );
  }

  const pager = wall ? createPager({ list: wall, name: 'decks', items, perPage: 4 }) : undefined;

  for (const button of buttons) {
    button.addEventListener('click', () => {
      type = button.dataset.filter ?? 'all';
      for (const other of buttons) {
        other.setAttribute('aria-pressed', String(other === button));
      }
      pager?.reset();
    });
  }
</script>

<style>
  /* Filters read as an option on the command above them. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-ink-soft);
  }

  .filters button {
    padding: 0.125rem 1ch;
    background: transparent;
    border: var(--border) solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink-soft);
    font: inherit;
    cursor: pointer;
  }

  .filters button:hover {
    border-color: var(--color-ink-soft);
    color: var(--color-ink);
  }

  .filters button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: calc(var(--wall-gap) * 1.25) var(--wall-gap);
    align-items: start;
  }

  .wall :global([hidden]) {
    display: none;
  }

  /* On one screen the wall takes the height it is given; the pager decides
     how many rows that is. */
  @media (min-width: 60rem) and (min-height: 34rem) {
    :global(html.paged) .wall {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      align-content: start;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
      gap: var(--wall-gap);
    }
  }

  /* An empty pane, built like a deck pane (bar, 16:9 body, status line) so it
     is exactly the same size. The bars are invisible spacers. */
  .empty-slot {
    display: flex;
    flex-direction: column;
    border: var(--border) dashed var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .slot-bar {
    padding: 0.375rem 0.75rem;
    border-bottom: var(--border) solid transparent;
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .slot-bar::before {
    content: '\00a0';
  }

  .slot-bar:last-child {
    border-top: var(--border) solid transparent;
    border-bottom: 0;
  }

  .slot-body {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    min-height: 0;
    overflow: hidden;
    padding: 1rem;
  }

  /* The one moving thing on the page: a cursor waiting for the next deck. */
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.5ch;
    vertical-align: text-bottom;
    background: var(--color-prompt);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  /* The outlines fill the first row and no more: with one or two columns
     a second outline would start a row of its own. */
  @media (max-width: 64rem) {
    .empty-slot + .empty-slot {
      display: none;
    }
  }
</style>
