---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { linkLabels, typeLabels } from '../site.config';

interface Props {
  deck: CollectionEntry<'decks'>;
  /** decks/<slug>/cover.(png|jpg|webp), when the deck has one. */
  cover?: ImageMetadata;
}

const { deck, cover } = Astro.props;
const { title, date, type, event, slides, links, draft } = deck.data;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const href = `${base}/decks/${deck.id}/`;
const isoDate = date.toISOString().slice(0, 10);
const extraLinks = Object.entries(links);
---

<article class="deck" data-type={type}>
  <!-- The deck as a terminal pane: path in the title bar, slide in the body,
       facts in the status line. The whole pane is the link. -->
  <a class="pane" href={href} aria-labelledby={`deck-${deck.id}`}>
    <span class="pane-bar" aria-hidden="true">
      <span class="pane-path">decks/{deck.id}</span>
      <span>{typeLabels[type]?.one.toLowerCase() ?? type}</span>
    </span>

    <span class="pane-body">
      {
        cover ? (
          <Image src={cover} alt="" widths={[480, 960]} sizes="(min-width: 60rem) 30vw, (min-width: 36rem) 45vw, 90vw" />
        ) : (
          <span class="pane-title" aria-hidden="true">{title}</span>
        )
      }
    </span>

    <span class="pane-status" aria-hidden="true">
      <span>{isoDate}</span>
      <span>{slides} {slides === 1 ? 'slide' : 'slides'}</span>
    </span>
  </a>

  <h3 id={`deck-${deck.id}`} class:list={{ 'visually-hidden': !cover }}>{title}</h3>

  <dl class="visually-hidden">
    <dt>Date</dt>
    <dd><time datetime={isoDate}>{isoDate}</time></dd>
    <dt>Kind</dt>
    <dd>{typeLabels[type]?.one ?? type}</dd>
    <dt>Length</dt>
    <dd>{slides} {slides === 1 ? 'slide' : 'slides'}</dd>
  </dl>

  {
    (event || draft || extraLinks.length > 0) && (
      <ul class="deck-notes">
        {event && <li>{event}</li>}
        {draft && <li class="deck-draft">draft, hidden when published</li>}
        {extraLinks.map(([name, url]) => (
          <li><a href={url}>{(linkLabels[name] ?? name).toLowerCase()}</a></li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .deck {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pane {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: var(--border) solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
  }

  /* The pane you point at becomes the active one, as in a multiplexer. */
  .pane:hover,
  .pane:focus-visible {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .pane-bar,
  .pane-status {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.375rem 0.75rem;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
    line-height: 1.5;
    white-space: nowrap;
  }

  .pane-bar {
    border-bottom: var(--border) solid var(--color-line);
  }

  .pane-status {
    border-top: var(--border) solid var(--color-line);
    font-variant-numeric: tabular-nums;
  }

  .pane-path {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pane:hover .pane-path,
  .pane:focus-visible .pane-path {
    color: var(--color-accent);
  }

  /* Every pane is the same size, whatever is on the cover: the body is
     always 16:9 and never grows to fit its content. */
  .pane-body {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    min-height: 0;
    overflow: hidden;
  }

  .pane-body :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Typeset cover, used until the deck ships its own cover image. A title
     longer than three lines ends in an ellipsis instead of growing the pane. */
  .pane-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    max-width: 18ch;
    margin: 6cqi;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 7.5cqi, 2.25rem);
    font-weight: var(--weight-strong);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* A block cursor after the title of the pane you are about to open. */
  .pane-title::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.95em;
    margin-left: 0.15em;
    vertical-align: -0.08em;
    background: transparent;
  }

  .pane:hover .pane-title::after,
  .pane:focus-visible .pane-title::after {
    background: var(--color-prompt);
  }

  h3 {
    margin-top: 0.75rem;
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
  }

  .deck-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
    margin: 0.375rem 0 0;
    padding: 0 0 0 2ch;
    list-style: none;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .deck-draft {
    color: var(--color-flag);
  }
</style>
