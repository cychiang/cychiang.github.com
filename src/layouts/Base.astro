---
import '../styles/global.css';
import { color } from '../../design/tokens.ts';
import { site } from '../site.config';

interface Props {
  /** Page title. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Path of the Open Graph image under /og/, e.g. "posts/2026-note". */
  ogImage?: string;
  /** Set for posts: adds article metadata. */
  article?: { published: Date; tags: string[] };
  /** JSON-LD structured data for the page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, ogImage = 'site', article, jsonLd } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${base}/og/${ogImage}.png`, Astro.site);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={`${base}/rss.xml`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={color.light.bg} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={color.dark.bg} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:author" content={site.author.url} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="page site-header">
      <a class="site-name" href={`${base}/`}>{site.name}</a>
      <nav aria-label="Site">
        <ul>
          {site.pages.map((page) => {
            const href = `${base}/${page.path}`;
            const current = Astro.url.pathname.replace(/\/?$/, '/') === href;
            return (
              <li><a href={href} aria-current={current ? 'page' : undefined}>{page.label}</a></li>
            );
          })}
          {site.links.map((link) => (
            <li><a href={link.href} rel="me">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="page">
      <slot />
    </main>

    <footer class="page site-footer">
      <p>
        Built with <a href="https://astro.build">Astro</a> and <a href="https://sli.dev">Slidev</a>.
        The <a href={site.repo}>source is on GitHub</a>. <a href={`${base}/rss.xml`}>RSS</a>.
      </p>
    </footer>
  </body>
</html>

<style>
  /* The header is the terminal's title bar: a rule under it, nothing more. */
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-block: 1.125rem;
    border-bottom: var(--border) solid var(--color-line);
  }

  .site-name {
    color: var(--color-ink);
    font-weight: var(--weight-strong);
  }

  nav ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A finger-sized target around each link without changing the layout. */
  nav a {
    display: inline-block;
    padding: 0.625rem 0.25rem;
    margin: -0.625rem 0;
  }

  nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  main {
    flex: 1;
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 1.125rem 1.5rem;
    border-top: var(--border) solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
</style>
