{
  "name": "cychiang.github.io",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Personal site: a wall of Slidev decks, built with Astro.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "deck": "node scripts/deck.ts",
    "new:deck": "node scripts/new-deck.ts",
    "check": "pnpm run design:check && node scripts/check-decks.ts && node scripts/check-posts.ts && node scripts/check-about.ts && astro check && pnpm run design:specimen",
    "build": "pnpm run build:site && pnpm run build:decks",
    "build:site": "astro build",
    "build:decks": "node scripts/build-decks.ts",
    "preview": "astro preview",
    "design:build": "node scripts/design-build.ts",
    "design:check": "node scripts/design-build.ts --check",
    "design:preview": "slidev design/templates/deck/slides.md",
    "design:specimen": "slidev build design/templates/deck/slides.md --out ../../../.specimen",
    "new:post": "node scripts/new-post.ts"
  },
  "slidev": {
    "addons": [
      "site"
    ]
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@slidev/cli": "^53.0.0",
    "@slidev/parser": "^53.0.0",
    "astro": "^7.4.0",
    "mermaid": "^12.1.0",
    "satori": "^0.44.1",
    "slidev-addon-site": "workspace:*",
    "slidev-theme-terminal": "workspace:*",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3"
  }
}
